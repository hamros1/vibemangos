/**
 * The client's movement opcodes, whose bodies are a `MovementInfo` and nothing
 * else: every `MSG_MOVE_*` opcode except `MSG_MOVE_TIME_SKIPPED` (a guid and a
 * time), the teleport messages, which have handlers of their own, and the
 * speed changes the server sends. Collected
 * from `Opcode` at compile time, so an opcode added there is routed to the
 * movement handler without further changes.
 */
enum Opcode[] movementOpcodes = () {
    import std.algorithm.searching : canFind, startsWith;

    // Not a MovementInfo, or a reply to the server rather than a move to show others.
    enum notMovement = ["MSG_MOVE_TIME_SKIPPED", "MSG_MOVE_TELEPORT", "MSG_MOVE_TELEPORT_ACK",
        "MSG_MOVE_WORLDPORT_ACK", "MSG_MOVE_SET_RUN_SPEED", "MSG_MOVE_SET_RUN_BACK_SPEED", "MSG_MOVE_SET_SWIM_SPEED",
        "MSG_MOVE_SET_SWIM_BACK_SPEED"];
    Opcode[] opcodes;
    static foreach (name; __traits(allMembers, Opcode))
        static if (name.startsWith("MSG_MOVE_") && !notMovement.canFind(name))
            opcodes ~= __traits(getMember, Opcode, name);
    return opcodes;
}();

static assert(movementOpcodes.length == 21);

/**
 * Whether no two members of `E` share a value, except the members named in `aliases` (each meant to repeat
 * another's value). Checked at compile time below, for the enums whose values come from the client.
 */
bool uniqueValues(E, aliases...)()
{
    import std.algorithm.searching : canFind;
    import std.traits : EnumMembers;

    enum string[] allowed = [aliases];
    string[] names;
    static foreach (m; __traits(allMembers, E))
        names ~= m;
    foreach (i, a; [EnumMembers!E])
        foreach (j, b; [EnumMembers!E])
            if (i < j && a == b && !allowed.canFind(names[i]) && !allowed.canFind(names[j]))
                return false;
    return true;
}

static assert(uniqueValues!(Opcode)(), "two opcodes share a value");
static assert(uniqueValues!(CharacterResponse, "CHAR_DELETE_FAILED_GUILD_LEADER")(),
    "two character responses share a value");

unittest
{
    enum Probe { a = 1, b = 2, c = 1 }
    static assert(!uniqueValues!Probe());
    static assert(uniqueValues!(Probe, "c")());
}
