/**
 * A small leveled logger.
 *
 * One function is generated by a mixin for every member of `LogLevel`
 * (`trace`, `verbose`, `info`, `warning`, `error`). Each takes its format
 * string as a template argument, so `info!"%s logged in"(name)` has its
 * format checked against its arguments at compile time.
 */
module dmangos.log;

import core.time : Duration;
import std.datetime.systime : Clock;
import std.format : format;
import std.stdio : stderr;

/// Severity of a log message, least severe first.
enum LogLevel : ubyte
{
    trace,
    verbose,
    info,
    warning,
    error,
}

private __gshared LogLevel threshold = LogLevel.info;

/// Sets the least severe level that is still written.
void setLogLevel(LogLevel level) @trusted nothrow @nogc
{
    threshold = level;
}

/// The least severe level that is still written.
LogLevel logLevel() @trusted nothrow @nogc
{
    return threshold;
}

/// Upper-case, fixed-width tags for each level, built at compile time.
private static immutable string[] levelTags = () {
    import std.string : leftJustify, toUpper;

    string[] tags;
    static foreach (name; __traits(allMembers, LogLevel))
        tags ~= name.toUpper.leftJustify(7);
    return tags;
}();

static assert(levelTags[LogLevel.warning] == "WARNING");

/// Writes a message at `level` if that level is enabled.
void logMessage(LogLevel level, string fmt, Args...)(auto ref Args args)
{
    if (level < logLevel)
        return;
    emit(level, format!fmt(args));
}

private void emit(LogLevel level, string message) @trusted nothrow
{
    try
    {
        auto now = Clock.currTime;
        now.fracSecs = Duration.zero;
        stderr.writefln("%s %s %s", now.toISOExtString(), levelTags[level], message);
    }
    catch (Exception)
    {
        // Logging must never take the server down.
    }
}

// Generates `trace`, `verbose`, `info`, `warning` and `error`.
static foreach (name; __traits(allMembers, LogLevel))
{
    mixin(`void ` ~ name ~ `(string fmt, Args...)(auto ref Args args)
    {
        logMessage!(LogLevel.` ~ name ~ `, fmt)(args);
    }`);
}

unittest
{
    const previous = logLevel;
    scope (exit)
        setLogLevel(previous);

    setLogLevel(LogLevel.error);
    // Below the threshold: compiles (the format is checked) but writes nothing.
    info!"%s is %d"("answer", 42);
    static assert(!__traits(compiles, info!"%d"("not a number")));
}
