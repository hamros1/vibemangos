{
	"name": "dmangos",
	"description": "A World of Warcraft 1.12 (vanilla) server written in D.",
	"license": "AGPL-3.0-or-later",
	"targetPath": "bin",
	"preBuildCommands": [
		"make -s -C $PACKAGE_DIR/thirdparty"
	],
	"sourceFiles": [
		"thirdparty/build/libdmnav.a"
	],
	"libs": [
		"stdc++"
	],
	"buildTypes": {
		"release-fast": {
			"buildOptions": ["releaseMode", "optimize"]
		},
		"profile": {
			"buildOptions": ["releaseMode", "optimize", "debugInfo"]
		}
	},
	"configurations": [
		{
			"name": "authserver",
			"targetType": "executable",
			"targetName": "authserver",
			"mainSourceFile": "source/dmangos/auth/main.d",
			"excludedSourceFiles": [
				"source/dmangos/extractor/main.d",
				"source/dmangos/loadgen/main.d",
				"source/dmangos/world/main.d"
			]
		},
		{
			"name": "worldserver",
			"targetType": "executable",
			"targetName": "worldserver",
			"mainSourceFile": "source/dmangos/world/main.d",
			"excludedSourceFiles": [
				"source/dmangos/auth/main.d",
				"source/dmangos/extractor/main.d",
				"source/dmangos/loadgen/main.d"
			]
		},
		{
			"name": "extractor",
			"targetType": "executable",
			"targetName": "extractor",
			"mainSourceFile": "source/dmangos/extractor/main.d",
			"excludedSourceFiles": [
				"source/dmangos/auth/main.d",
				"source/dmangos/loadgen/main.d",
				"source/dmangos/world/main.d"
			]
		},
		{
			"name": "loadgen",
			"targetType": "executable",
			"targetName": "loadgen",
			"mainSourceFile": "source/dmangos/loadgen/main.d",
			"excludedSourceFiles": [
				"source/dmangos/auth/main.d",
				"source/dmangos/world/main.d",
				"source/dmangos/extractor/main.d"
			]
		}
	]
}
